<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yang.blog.mapper.UConsumptionTypeMapper">
    <resultMap id="map" type="com.yang.blog.entity.UConsumptionTypeEntity">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="color" property="color"/>
        <result column="keywords" property="keywords"/>
    </resultMap>

    <select id="getConsumptionTypeAll" resultMap="map">
        SELECT t.id,t.name,t.color,t.keywords FROM u_consumption_type t ORDER BY id DESC
    </select>

    <select id="getConsumptionTypeById" resultMap="map">
        SELECT t.id,t.name,t.color,t.keywords FROM u_consumption_type t WHERE t.id IN
        <foreach collection="array" index="index" separator="," open="(" close=")" item="item">
            #{item}
        </foreach>
    </select>

    <select id="getConsumptionTypeByName" resultMap="map" parameterType="string">
        SELECT t.id,t.name,t.color,t.keywords FROM u_consumption_type t WHERE `name` LIKE CONCAT('%',#{name},'%') ORDER BY id DESC
    </select>

    <insert id="addConsumptionType" parameterType="com.yang.blog.entity.UConsumptionTypeEntity">
        INSERT INTO u_consumption_type (id,`name`,color,keywords)
        VALUES(#{id,jdbcType=VARCHAR},#{name,jdbcType=VARCHAR},#{color,jdbcType=VARCHAR},#{keywords,jdbcType=VARCHAR})
    </insert>

    <update id="updConsumptionTypeById" parameterType="com.yang.blog.entity.UConsumptionTypeEntity">
        UPDATE u_consumption_type SET `name`=#{name,jdbcType=VARCHAR},color=#{color,jdbcType=VARCHAR},keywords=#{keywords,jdbcType=VARCHAR}
        WHERE id=#{id,jdbcType=VARCHAR}
    </update>

    <update id="updConsumptionTypeByName">
        UPDATE u_consumption_type
        SET keywords =
            CASE
                WHEN keywords IS NULL OR keywords = '' THEN #{key}
                ELSE CONCAT_WS('、', keywords, #{key})
            END
        WHERE `name` = #{name}
    </update>

    <delete id="delConsumptionType" parameterType="String">
        DELETE FROM u_consumption_type WHERE id=#{id,jdbcType=VARCHAR}
    </delete>
</mapper>