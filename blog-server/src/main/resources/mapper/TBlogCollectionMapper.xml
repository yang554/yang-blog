<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yang.blog.mapper.TBlogCollectionMapper">
    <resultMap id="map" type="com.yang.blog.entity.TBlogCollectionEntity">
        <id column="id" property="Id"/>
        <result column="blog_id" property="blogId"/>
        <result column="user_id" property="userId"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="isUserCollection" resultType="map">
        SELECT * FROM t_blog_collection WHERE user_id = #{uID}) AND blog_id =  #{bID}
    </select>
    <insert id="insertBatch">
        INSERT IGNORE INTO t_blog_collection (id,blog_id,user_id)
        VALUES
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.Id}, #{item.blogId}, #{item.userId})
        </foreach>
    </insert>

    <delete id="deleteBatch">
        DELETE FROM t_blog_collection WHERE
        <foreach collection="list" index="index" item="item" separator="," open="(" close=")">
            user_id = ${item.userId} AND blog_id = ${item.blogId}
        </foreach>
    </delete>

</mapper>