{
  "files": [],
  "references": [
    {
      "path": "tsconfig.node.json"
    },
    {
      "path": "tsconfig.app.json"
    },
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"]
    },
    "types": ["vite/client", "element-plus/global"],
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
